# App image
APP_IMAGE_TAG=v0.5
APP_PORT=8080

# PostgreSQL VM
POSTGRES_URL=jdbc:postgresql://<db-vm-host>:5432/goldrush
POSTGRES_DB=goldrush
POSTGRES_USER=goldrush
POSTGRES_PASSWORD=change-me
DB_CONNECTION_POOL_SIZE=50

# Kafka VM external listener
KAFKA_BOOTSTRAP_SERVERS=<kafka-vm-host>:9092

# Shared Redis VM
REDIS_HOST=<redis-vm-host>
REDIS_PORT=6379

# SSE
SSE_HEARTBEAT_INTERVAL_MILLIS=15000
