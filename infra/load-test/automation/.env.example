# 선택 사항: CLI 옵션 대신 환경변수로 지정할 수 있습니다.
VERSION=v0.1
REQUEST_HOST=http://localhost:8080/api
MONITOR_HOST=http://localhost:9090
GRAFANA_URL=http://localhost:3000
DB_URL=postgresql://goldrush@localhost:5432/goldrush
PGPASSWORD=change-me
# 선택 사항. PATH에 psql이 없다면 Homebrew libpq 경로를 자동 탐지합니다.
# PSQL_BIN=/opt/homebrew/opt/libpq/bin/psql
SCENARIO=hotspot

# Grafana basic auth 또는 service account token 중 하나를 사용합니다.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
# GRAFANA_TOKEN=
GRAFANA_DASHBOARD_UID=gold-rush-lab

ITERATIONS=100
REPEAT_COUNT=5
VU_LIST=10,50,100,300,500

# Prometheus label matcher. 중괄호는 쓰지 않습니다.
PROM_LABELS='application="gold-rush-lab"'
CONSUMER_PROM_LABELS='application="gold-rush-consumer"'
POSTGRES_PROM_LABELS='application="gold-rush-postgres"'
MINE_URI=/mine

# Event-driven benchmark
KAFKA_CONSUMER_GROUP=gold-rush-mining-consumer
KAFKA_REQUEST_TOPIC=mining-requested
KAFKA_COMPLETION_GROUP=gold-rush-sse-relay
KAFKA_COMPLETION_TOPIC=mining-completed
POSTGRES_DATABASE=goldrush
DRAIN_POLL_SECONDS=1
DRAIN_TIMEOUT_SECONDS=600
DRAIN_STABLE_SAMPLES=2
DRAIN_LAG_THRESHOLD=0
SSE_CLIENT_TIMEOUT_SECONDS=600
SSE_READY_TIMEOUT_SECONDS=120
SSE_READY_POLL_SECONDS=1
SSE_FINALIZE_GRACE_SECONDS=2

# 다음 실행을 허용하는 안정화 기준
STABLE_PROCESS_CPU_PCT=20
STABLE_SYSTEM_CPU_PCT=50
STABLE_HEAP_PCT=75
STABLE_HIKARI_PCT=20
STABLE_TPS=0
STABLE_SAMPLES=3
STABLE_POLL_SECONDS=5
STABLE_TIMEOUT_SECONDS=600
POST_STABLE_COOLDOWN_SECONDS=30

# PostgreSQL pg_locks 관측 간격(초)
LOCK_WAIT_POLL_SECONDS=1
